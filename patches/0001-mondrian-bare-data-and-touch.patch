+/// Whether the phone's own table says the data partition is encrypted
+/// whole. A phone whose table names no `metadata_encryption=` for it keeps
+/// the filesystem bare on the partition, as some vendor builds of this
+/// generation do, and it is mounted as it lies. This is asked of the
+/// table alone, so that nothing reads `/data/unencrypted` before the
+/// partition is mounted.
+pub fn encrypted_whole(entry: &Entry) -> bool {
+    entry.extra("metadata_encryption").is_some()
+}
+
+/// Whether the phone keeps its filesystem bare on the data partition, so
+/// that nothing of it has to be unwrapped before it reads. Asked of the
+/// table alone, before anything touches the partition or the key service.
+pub fn opens_bare() -> Result<bool> {
+    Ok(!encrypted_whole(&data_entry()?))
+}
+
+/// Mount a data partition that is bare on its own: no key unwrapped, no
+/// mapping made, the filesystem checked and mounted where it lies, and the
+/// owner's shared storage shown as on the phone. Nothing of it is closed,
+/// there being no user whose own key was never let in.
+pub fn open_bare() -> Result<Opening> {
+    let mounted = match mount::is_mount_point(Path::new(MOUNT))? {
+        true => None,
+        false => Some(open_bare_at_once()?),
+    };
+    show_owner_storage()?;
+    Ok(Opening { mounted, closed: Vec::new() })
+}
+
+/// Check and mount a bare data partition, and give how it was mounted.
+fn open_bare_at_once() -> Result<Opened> {
+    let bare = data_entry()?;
+    let device = skyward_block::fstab::device(&bare)?;
+    let checked = match bare.extras.iter().any(|e| e == "check") {
+        true => Some(skyward_block::fsck::check(Path::new(&device), &bare.filesystem)?),
+        false => None,
+    };
+    std::fs::create_dir_all(MOUNT).with_context(|| format!("make {MOUNT}"))?;
+    mount::mount(Path::new(&device), Path::new(MOUNT), &bare.filesystem, &bare.options)?;
+    Ok(Opened { mapped: PathBuf::from(device), filesystem: bare.filesystem.clone(), checked })
+}
+
+/// The first table entry for the data partition, whatever the phone says
+/// of its encryption.
+fn data_entry() -> Result<Entry> {
+    let entries = skyward_block::fstab::read(MOUNT)?;
+    entries.into_iter().next().with_context(|| format!("the phone's own table says nothing about {MOUNT}"))
+}
