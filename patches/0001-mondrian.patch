+/// Say what the phone's table and the kernel say of the things a page
+/// reads, so that the values a page shows can be checked against them.
+#[cfg(target_os = "android")]
+fn inspect_phone() {
+    let _ = skyward_sys::kmsg("---- what the phone says of itself ----");
+    for at in ["/proc/cmdline", "/sys/devices/system/cpu/possible", "/sys/devices/system/cpu/present"] {
+        match std::fs::read_to_string(at) {
+            Ok(text) => {
+                let _ = skyward_sys::kmsg(&format!("{at} = {}", text.trim()));
+            }
+            Err(e) => {
+                let _ = skyward_sys::kmsg(&format!("{at} = <{e}>"));
+            }
+        }
+    }
+    for id in 0..16 {
+        let at = format!("/sys/devices/system/cpu/cpu{id}/cpufreq/cpuinfo_max_freq");
+        if let Ok(text) = std::fs::read_to_string(&at) {
+            let _ = skyward_sys::kmsg(&format!("cpu{id} cpuinfo_max_freq = {}", text.trim()));
+        }
+    }
+    match std::fs::read_to_string("/vendor/etc/fstab.qcom") {
+        Ok(text) => {
+            for line in text.lines() {
+                if line.contains("/data ") && !line.trim_start().starts_with('#') {
+                    let _ = skyward_sys::kmsg(&format!("fstab data: {line}"));
+                }
+            }
+        }
+        Err(e) => {
+            let _ = skyward_sys::kmsg(&format!("fstab.qcom = <{e}>"));
+        }
+    }
+    for at in ["/data/unencrypted", "/data/misc/vold/user_keys"] {
+        let _ = skyward_sys::kmsg(&format!("{at} exists = {}", Path::new(at).exists()));
+    }
+    let _ = skyward_sys::kmsg("---- end what the phone says ----");
+}
