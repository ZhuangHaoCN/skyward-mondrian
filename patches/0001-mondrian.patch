+/// Keep every line [`kmsg`] writes from now on in the file on the
+/// partition that outlives the boot as well, begun afresh each run so that
+/// what a run said is what the file holds. Failing to open it is not an
+/// error: a phone whose persist is not there yet still runs.
+pub fn keep_durable_log() {
+    if DURABLE.get().is_some() {
+        return;
+    }
+    // Appended to, never cut: a run that ends before it could say why
+    // leaves what it did say at the end of the file, after every run
+    // before it. The file is capped where it is opened, oldest lines
+    // first, so that it cannot grow without end on a phone taken into the
+    // recovery many times.
+    const MOST: u64 = 1 << 20;
+    if let Ok(about) = std::fs::metadata(DURABLE_LOG) {
+        if about.len() > MOST {
+            let _ = std::fs::remove_file(DURABLE_LOG);
+        }
+    }
+    let opened = OpenOptions::new().create(true).append(true).open(DURABLE_LOG);
+    match opened {
+        Ok(file) => {
+            let _ = DURABLE.set(Mutex::new(file));
+        }
+        Err(e) => {
+            let _ = kmsg(&format!("no durable log: {e}"));
+        }
+    }
+}
